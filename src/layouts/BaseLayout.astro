---
export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogTitle?: string;
  ogDescription?: string;
  activeNav?: string;
}

const {
  title,
  description,
  canonical,
  ogTitle,
  ogDescription,
  activeNav = '',
} = Astro.props;

const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const ogT = ogTitle ?? title;
const ogD = ogDescription ?? description;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonicalURL}>
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Mind Menders Psychiatric Care">
  <meta property="og:url" content={canonicalURL}>
  <meta property="og:title" content={ogT}>
  <meta property="og:description" content={ogD}>
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content={ogT}>
  <meta name="twitter:description" content={ogD}>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <div class="crisis-bar">In crisis? Call or text <a href="tel:988">988</a> or <a href="tel:911">911</a></div>

  <nav class="navbar" id="navbar">
    <div class="nav-inner">
      <a href="/" class="nav-logo">
        <img src="/logo-icon.png" alt="Mind Menders Logo" class="nav-logo-img">
        <div class="nav-logo-text">
          <span class="nav-logo-primary">Matthew Mauro, PMHNP-BC</span>
          <span class="nav-logo-secondary">Mind Menders Psychiatric Care</span>
        </div>
      </a>
      <ul class="nav-links">
        <li><a href="/" class={activeNav === 'home' ? 'active' : ''}>Home</a></li>
        <li><a href="/about" class={activeNav === 'about' ? 'active' : ''}>About</a></li>
        <li><a href="/services" class={activeNav === 'services' ? 'active' : ''}>Services</a></li>
        <li><a href="/telehealth" class={activeNav === 'telehealth' ? 'active' : ''}>Telehealth</a></li>
        <li><a href="/faq" class={activeNav === 'faq' ? 'active' : ''}>FAQ</a></li>
        <li><a href="/blog" class={activeNav === 'blog' ? 'active' : ''}>Blog</a></li>
        <li><a href="/contact" class={activeNav === 'contact' ? 'active' : ''}>Contact</a></li>
      </ul>
      <a href="tel:4437987707" class="btn btn-primary btn-sm nav-cta">&#128222; (443) 798-7707</a>
      <button class="nav-mobile-btn" id="mobileBtn">&#9776;</button>
    </div>
    <div class="nav-mobile-menu" id="mobileMenu">
      <a href="/">Home</a>
      <a href="/about">About</a>
      <a href="/services">Services</a>
      <a href="/telehealth">Telehealth</a>
      <a href="/faq">FAQ</a>
      <a href="/blog">Blog</a>
      <a href="/contact">Contact</a>
      <a href="tel:4437987707" class="btn btn-primary">(443) 798-7707</a>
    </div>
  </nav>

  <slot />

  <footer>
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand">
          <a href="/" class="footer-logo">
            <img src="/logo-icon.png" alt="Logo" class="footer-logo-img">
            <div class="footer-logo-text">
              <span class="footer-logo-primary">Matthew Mauro, PMHNP-BC</span>
              <span class="footer-logo-secondary">Mind Menders Psychiatric Care</span>
            </div>
          </a>
          <p>Compassionate psychiatric care for all ages in Towson, MD.</p>
        </div>
        <div class="footer-col">
          <h4>Navigate</h4>
          <ul>
            <li><a href="/about">About</a></li>
            <li><a href="/services">Services</a></li>
            <li><a href="/telehealth">Telehealth</a></li>
            <li><a href="/contact">Contact</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4>Conditions</h4>
          <ul>
            <li><a href="/adhd">ADHD</a></li>
            <li><a href="/anxiety">Anxiety</a></li>
            <li><a href="/depression">Depression</a></li>
            <li><a href="/autism">Autism</a></li>
            <li><a href="/bipolar">Bipolar Disorder</a></li>
            <li><a href="/ptsd-ocd">PTSD &amp; OCD</a></li>
            <li><a href="/schizophrenia">Schizophrenia</a></li>
            <li><a href="/mood-disorders">Mood Disorders</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4>Contact</h4>
          <ul>
            <li><a href="tel:4437987707">(443) 798-7707</a></li>
            <li><a href="mailto:mmauro@caapsych.com">mmauro@caapsych.com</a></li>
            <li>1200 E Joppa Rd, Suite A, Towson MD</li>
          </ul>
        </div>
      </div>
      <hr class="footer-divider">
      <div class="footer-bottom">
        <div class="footer-legal">
          <p>Information on this site does not constitute medical advice. In emergencies, call 911 or 988.</p>
        </div>
        <div class="footer-copy">&copy; {new Date().getFullYear()} Matthew Mauro, PMHNP-BC &bull; Mind Menders Psychiatric Care</div>
      </div>
    </div>
  </footer>

  <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
  <script>
    // Netlify Identity redirect after login
    if (window.netlifyIdentity) {
      window.netlifyIdentity.on("init", user => {
        if (!user) {
          window.netlifyIdentity.on("login", () => { document.location.href = "/admin/"; });
        }
      });
    }
    const nb = document.getElementById("navbar");
    window.addEventListener("scroll", () => nb?.classList.toggle("scrolled", window.scrollY > 20));
    document.getElementById("mobileBtn")?.addEventListener("click", function() {
      const m = document.getElementById("mobileMenu");
      m?.classList.toggle("open");
      this.textContent = m?.classList.contains("open") ? "✕" : "☰";
    });
  </script>
</body>
</html>
