---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const pubDate = post.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric'
});
---
<BaseLayout
  title={`${post.data.title} | Mind Menders`}
  description={post.data.description}
  activeNav="blog"
>
<section class="page-hero">
  <div class="container">
    <nav class="breadcrumb">
      <a href="/">Home</a> &rsaquo; <a href="/blog">Blog</a> &rsaquo; <span>{post.data.title}</span>
    </nav>
    <span class="eyebrow-white">Article</span>
    <h1>{post.data.title}</h1>
    <p>{pubDate} &bull; {post.data.author}</p>
  </div>
</section>

<section class="section">
  <div class="container" style="max-width:760px">
    {post.data.tags && (
      <div style="margin-bottom:var(--sp-6);display:flex;gap:var(--sp-2);flex-wrap:wrap">
        {post.data.tags.map(tag => (
          <span class="blog-tag">{tag}</span>
        ))}
      </div>
    )}
    <div class="blog-content prose">
      <Content />
    </div>
    <hr class="footer-divider" style="margin:var(--sp-10) 0">
    <div style="display:flex;gap:var(--sp-4);flex-wrap:wrap">
      <a href="/blog" class="btn btn-secondary">&#8592; All Articles</a>
      <a href="/contact" class="btn btn-primary">Schedule an Appointment</a>
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": post.data.title,
  "description": post.data.description,
  "datePublished": post.data.pubDate.toISOString(),
  "author": {
    "@type": "Person",
    "name": post.data.author || "Matthew Mauro, PMHNP-BC",
    "url": "https://mindmenderz.com/about"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Mind Menders Psychiatric Care",
    "url": "https://mindmenderz.com",
    "logo": {
      "@type": "ImageObject",
      "url": "https://mindmenderz.com/logo-icon.png"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://mindmenderz.com/blog/${post.slug}`
  },
  "keywords": post.data.tags ? post.data.tags.join(", ") : undefined
})} />

<section class="cta-section">
  <div class="container">
    <h2>Ready to Get Started?</h2>
    <p>Call or schedule online to begin your care with Matthew Mauro, PMHNP-BC.</p>
    <div class="cta-phone"><a href="tel:4437987707">(443) 798-7707</a></div>
    <div class="cta-actions">
      <a href="/contact" class="btn btn-white btn-lg">Schedule Appointment</a>
      <a href="/services" class="btn btn-outline-white btn-lg">All Services</a>
    </div>
  </div>
</section>
</BaseLayout>

<style>
  .prose h2 { font-size: var(--text-2xl); margin: var(--sp-8) 0 var(--sp-3); color: var(--navy); }
  .prose h3 { font-size: var(--text-xl); margin: var(--sp-6) 0 var(--sp-2); color: var(--navy); }
  .prose p { margin-bottom: var(--sp-4); line-height: 1.75; color: var(--text); }
  .prose ul, .prose ol { margin: var(--sp-4) 0 var(--sp-4) var(--sp-6); }
  .prose li { margin-bottom: var(--sp-2); line-height: 1.7; color: var(--text); }
  .prose strong { color: var(--navy); }
</style>
