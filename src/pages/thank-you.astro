---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Thank You | Mind Menders Psychiatric Care"
  description="Your appointment request has been received. We will contact you within 1 business day."
  activeNav=""
>
<div class="page-hero">
  <div class="container" style="text-align:center">
    <p class="eyebrow-white">Request Received</p>
    <h1>Thank You!</h1>
    <p>Your appointment request has been submitted successfully. We will contact you within 1 business day to confirm your appointment.</p>
  </div>
</div>

<section class="section">
  <div class="container" style="max-width:700px;text-align:center">
    <div style="font-size:4rem;margin-bottom:1.5rem">&#9989;</div>
    <h2 style="margin-bottom:1rem">What Happens Next?</h2>
    <p style="font-size:1.05rem;color:var(--text-muted);margin-bottom:2rem">Our team will review your request and reach out to schedule your appointment. If you need immediate assistance, please call us directly.</p>
    <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap">
      <a href="tel:4437987707" class="btn btn-primary btn-lg">Call (443) 798-7707</a>
      <a href="/" class="btn btn-outline btn-lg">Return Home</a>
    </div>
  </div>
</section>
</BaseLayout>
