---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Matthew Mauro, PMHNP-BC | Psychiatric Care Towson, MD | Mind Menders"
  description="Expert psychiatric care for children, adolescents & adults in Towson, MD. Matthew Mauro, PMHNP-BC specializes in ADHD, anxiety, depression, autism, PTSD, and bipolar disorder. In-person & telehealth available."
  activeNav="home"
>
<!-- HERO -->
<section class="hero">
  <div class="hero-blob hero-blob-1"></div>
  <div class="hero-blob hero-blob-2"></div>

  <div class="hero-content">
    <!-- Left: Text -->
    <div class="hero-text animate-in">
      <div class="hero-badge">
        <span class="hero-badge-dot"></span>
        Accepting New Patients
      </div>
      <h1>Compassionate Psychiatric Care for Every Stage of Life</h1>
      <p class="hero-sub">Expert evaluation, medication management, and evidence-based therapy for children, adolescents, and adults in Towson, MD. In-person and telehealth available statewide.</p>
      <div class="hero-actions">
        <a href="/contact" class="btn btn-white btn-lg">Schedule Appointment</a>
        <a href="tel:4437987707" class="btn btn-outline-white btn-lg">Call (443) 798-7707</a>
      </div>
      <div class="hero-trust">
        <div class="hero-trust-item">✓ Board Certified PMHNP-BC</div>
        <div class="hero-trust-item">✓ All Ages Welcome</div>
        <div class="hero-trust-item">✓ Telehealth Available</div>
      </div>
    </div>

    <!-- Right: Card -->
    <div class="hero-visual animate-in delay-2">
      <div class="hero-card">
        <div class="hero-card-logo">
          <img src="/logo-icon.png" alt="Mind Menders Logo">
        </div>
        <h3>Matthew Mauro, PMHNP-BC</h3>
        <p>Psychiatric Mental Health Nurse Practitioner &mdash; Board Certified</p>
        <div class="hero-card-stats">
          <div class="hero-stat">
            <div class="hero-stat-num">All</div>
            <div class="hero-stat-label">Ages Served</div>
          </div>
          <div class="hero-stat">
            <div class="hero-stat-num">MD</div>
            <div class="hero-stat-label">Statewide TH</div>
          </div>
          <div class="hero-stat">
            <div class="hero-stat-num">12+</div>
            <div class="hero-stat-label">Conditions</div>
          </div>
          <div class="hero-stat">
            <div class="hero-stat-num">&#128276;</div>
            <div class="hero-stat-label">New Patients</div>
          </div>
        </div>
        <a href="/contact" class="hero-card-cta">
          Request Appointment
          <span>&#8594;</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Wave divider -->
  <div class="hero-wave">
    <svg viewBox="0 0 1440 60" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
      <path d="M0 60L48 50C96 40 192 20 288 15C384 10 480 20 576 28C672 36 768 42 864 38C960 34 1056 20 1152 15C1248 10 1344 14 1392 16L1440 18V60H0Z" fill="#F8FFFE"/>
    </svg>
  </div>
</section>

<!-- TRUST BAR -->
<div class="trust-bar">
  <div class="trust-bar-inner">
    <div class="trust-item">&#127919; PMHNP-BC Board Certified</div>
    <div class="trust-divider"></div>
    <div class="trust-item">&#128100; Children, Teens & Adults</div>
    <div class="trust-divider"></div>
    <div class="trust-item">&#128241; In-Person & Telehealth</div>
    <div class="trust-divider"></div>
    <div class="trust-item">&#127968; Towson, MD &mdash; Suite A</div>
    <div class="trust-divider"></div>
    <div class="trust-item">&#9989; Most Insurance Accepted</div>
  </div>
</div>

<!-- CONDITIONS WE TREAT -->
<section class="section-sm section-light">
  <div class="container text-center">
    <p class="eyebrow">Conditions We Treat</p>
    <h2 class="mb-6">Specialized Care Across the Lifespan</h2>
    <div class="conditions-strip">
      <a href="/adhd" class="condition-pill"><span class="condition-dot"></span> ADHD</a>
      <a href="/anxiety" class="condition-pill"><span class="condition-dot"></span> Anxiety Disorders</a>
      <a href="/depression" class="condition-pill"><span class="condition-dot"></span> Depression</a>
      <a href="/autism" class="condition-pill"><span class="condition-dot"></span> Autism Spectrum</a>
      <a href="/ptsd-ocd" class="condition-pill"><span class="condition-dot"></span> PTSD &amp; OCD</a>
      <a href="/bipolar" class="condition-pill"><span class="condition-dot"></span> Bipolar Disorder</a>
      <a href="/schizophrenia" class="condition-pill"><span class="condition-dot"></span> Schizophrenia</a>
      <a href="/schizophrenia" class="condition-pill"><span class="condition-dot"></span> Thought Disorders</a>
      <a href="/mood-disorders" class="condition-pill"><span class="condition-dot"></span> Mood Disorders</a>
      <a href="/services" class="condition-pill"><span class="condition-dot"></span> Social Anxiety</a>
      <a href="/services" class="condition-pill"><span class="condition-dot"></span> Panic Disorder</a>
      <a href="/services" class="condition-pill"><span class="condition-dot"></span> Behavioral Issues</a>
    </div>
  </div>
</section>

<!-- SERVICES -->
<section class="section" id="services">
  <div class="container">
    <div class="section-header center">
      <span class="eyebrow">Our Services</span>
      <h2>Comprehensive Psychiatric Care</h2>
      <p class="lead">We combine expert medication management with evidence-based therapy to treat the whole person &mdash; not just the symptoms. Every treatment plan is individualized to your unique needs.</p>
    </div>

    <div class="services-grid">
      <!-- Featured -->
      <div class="service-card service-card-featured">
        <div class="service-icon-wrap">&#129504;</div>
        <h3>ADHD &mdash; Across All Ages</h3>
        <p>Comprehensive evaluation and evidence-based medication management for attention deficit hyperactivity disorder in children, teens, and adults. Clear diagnosis, personalized treatment, meaningful results.</p>
        <a href="/adhd" class="card-link">Learn more &#8594;</a>
      </div>

      <div class="service-card">
        <div class="service-icon-wrap">&#129490;</div>
        <h3>Autism Spectrum Disorder</h3>
        <p>Specialized psychiatric support for individuals with autism across the lifespan. Matthew brings deep clinical expertise and a personal commitment to autism care.</p>
        <a href="/autism" class="card-link">Learn more &#8594;</a>
      </div>

      <div class="service-card">
        <div class="service-icon-wrap">&#127774;</div>
        <h3>Depression</h3>
        <p>Evidence-based treatment for major depressive disorder and persistent depressive disorder. Restoring emotional balance and building resilience for a brighter future.</p>
        <a href="/depression" class="card-link">Learn more &#8594;</a>
      </div>

      <div class="service-card">
        <div class="service-icon-wrap">&#128153;</div>
        <h3>Anxiety Disorders</h3>
        <p>Comprehensive treatment for generalized anxiety, panic disorder, social anxiety, and related conditions. Targeted care that helps you reclaim your life.</p>
        <a href="/anxiety" class="card-link">Learn more &#8594;</a>
      </div>

      <div class="service-card">
        <div class="service-icon-wrap">&#128737;</div>
        <h3>PTSD &amp; OCD</h3>
        <p>Specialized trauma-informed care for post-traumatic stress disorder and obsessive-compulsive disorder using proven therapeutic approaches.</p>
        <a href="/ptsd-ocd" class="card-link">Learn more &#8594;</a>
      </div>

      <div class="service-card">
        <div class="service-icon-wrap">&#9878;</div>
        <h3>Bipolar Disorder</h3>
        <p>Careful mood stabilization and ongoing psychiatric management. Navigating the complexities of bipolar disorder with expertise and genuine compassion.</p>
        <a href="/bipolar" class="card-link">Learn more &#8594;</a>
      </div>

      <div class="service-card">
        <div class="service-icon-wrap">&#128161;</div>
        <h3>Schizophrenia &amp; Thought Disorders</h3>
        <p>Expert evaluation and medication management for schizophrenia, schizoaffective disorder, and complex thought disorders. Stability and compassion for patients and families.</p>
        <a href="/schizophrenia" class="card-link">Learn more &#8594;</a>
      </div>

      <!-- In-Person Card -->
      <div class="service-card" style="border-top:3px solid var(--teal)">
        <div class="service-icon-wrap" style="background:var(--teal-light)">&#127968;</div>
        <h3>In-Person Appointments</h3>
        <p>Visit our Towson, MD office for face-to-face psychiatric evaluation and ongoing care. Conveniently located at 1200 East Joppa Road, Suite A &mdash; accepting new patients now.</p>
        <a href="/contact" class="card-link">Book In-Person &#8594;</a>
      </div>

      <!-- Telehealth Card -->
      <div class="service-card" style="border-top:3px solid var(--teal-mid)">
        <div class="service-icon-wrap">&#128241;</div>
        <h3>Telehealth Throughout Maryland</h3>
        <p>Secure video appointments for patients anywhere in Maryland. Same expert care, same thorough evaluation &mdash; from the comfort of your home.</p>
        <a href="/telehealth" class="card-link">Learn more &#8594;</a>
      </div>
    </div>
  </div>
</section>

<!-- THERAPEUTIC APPROACHES -->
<section class="section section-light">
  <div class="container">
    <div class="section-header center">
      <span class="eyebrow">Therapeutic Approaches</span>
      <h2>More Than Medication</h2>
      <p class="lead">Healing isn&rsquo;t one-size-fits-all. Matthew combines psychiatric medication management with evidence-based therapy approaches tailored to each patient&rsquo;s unique needs.</p>
    </div>
    <div class="therapy-grid">
      <div class="therapy-card">
        <div class="therapy-icon">&#128172;</div>
        <h3>Talk Therapy</h3>
        <p>A safe, confidential space to explore thoughts, feelings, and experiences. Builds self-awareness and strengthens coping skills at your own pace.</p>
      </div>
      <div class="therapy-card">
        <div class="therapy-icon">&#129504;</div>
        <h3>Cognitive Behavioral Therapy (CBT)</h3>
        <p>Identify and reframe negative thought patterns. Structured, goal-oriented, and highly effective for anxiety, depression, and trauma.</p>
      </div>
      <div class="therapy-card">
        <div class="therapy-icon">&#128149;</div>
        <h3>Trauma-Informed Care</h3>
        <p>Recognizing how trauma shapes behavior and healing. A compassionate, safety-first approach woven into every aspect of treatment.</p>
      </div>
      <div class="therapy-card">
        <div class="therapy-icon">&#128138;</div>
        <h3>Medication Management</h3>
        <p>Careful prescribing, thorough monitoring, and ongoing adjustments. Evidence-based pharmacotherapy as part of a comprehensive care plan.</p>
      </div>
    </div>
  </div>
</section>

<!-- ABOUT SECTION -->
<section class="section" id="about">
  <div class="container">
    <div class="about-grid">
      <!-- Visual card -->
      <div class="about-visual">
        <div class="about-card">
          <div class="about-avatar">&#129657;</div>
          <div class="about-name">Matthew Mauro</div>
          <div class="about-credential">PMHNP-BC &mdash; Psychiatric Mental Health Nurse Practitioner</div>
          <div class="about-cred-list">
            <div class="about-cred">
              <span class="about-cred-icon">&#127979;</span>
              Board Certified PMHNP-BC
            </div>
            <div class="about-cred">
              <span class="about-cred-icon">&#127968;</span>
              1200 E Joppa Rd, Suite A, Towson, MD
            </div>
            <div class="about-cred">
              <span class="about-cred-icon">&#128100;</span>
              Children, Adolescents &amp; Adults
            </div>
            <div class="about-cred">
              <span class="about-cred-icon">&#128241;</span>
              In-Person &amp; Statewide Telehealth
            </div>
            <div class="about-cred">
              <span class="about-cred-icon">&#9989;</span>
              Most Major Insurance Accepted
            </div>
          </div>
        </div>
        <div class="about-badge">
          <div class="about-badge-num">MD</div>
          <div class="about-badge-label">Licensed</div>
        </div>
      </div>

      <!-- Text -->
      <div class="about-text">
        <span class="eyebrow">About Matthew</span>
        <h2>A Provider Who Truly Listens</h2>
        <p>Matthew Mauro is a board-certified Psychiatric Mental Health Nurse Practitioner (PMHNP-BC) with deep expertise in psychiatric evaluation and medication management across the entire lifespan &mdash; from young children to adults.</p>
        <p>His practice, Mind Menders Psychiatric Care, was founded on a simple but powerful belief: that every person deserves to be heard, respected, and given a treatment plan built around their unique story &mdash; not a cookie-cutter protocol.</p>
        <p>Matthew brings a rare combination of clinical rigor and genuine warmth to every appointment. He takes the time to understand not just your symptoms, but your life &mdash; your relationships, your goals, and what matters most to you.</p>

        <div class="about-features">
          <div class="about-feature">
            <span class="about-feature-icon">&#129504;</span>
            <div>
              <h4>ADHD Specialist</h4>
              <p>Extensive experience evaluating and managing ADHD at every age.</p>
            </div>
          </div>
          <div class="about-feature">
            <span class="about-feature-icon">&#129490;</span>
            <div>
              <h4>Autism Expert</h4>
              <p>Deep clinical knowledge and personal commitment to autism care.</p>
            </div>
          </div>
          <div class="about-feature">
            <span class="about-feature-icon">&#127968;</span>
            <div>
              <h4>Towson-Based</h4>
              <p>Convenient Towson, MD location with statewide telehealth.</p>
            </div>
          </div>
          <div class="about-feature">
            <span class="about-feature-icon">&#128149;</span>
            <div>
              <h4>Trauma-Informed</h4>
              <p>Safety-first, compassionate approach throughout treatment.</p>
            </div>
          </div>
        </div>
        <a href="/about" class="btn btn-primary">Meet Matthew &#8594;</a>
      </div>
    </div>
  </div>
</section>

<!-- INSURANCE -->
<section class="section-sm section-light" id="insurance">
  <div class="container text-center">
    <span class="eyebrow">Insurance</span>
    <h2 class="mb-4">Most Major Insurance Accepted</h2>
    <p class="lead mb-8">We accept most major insurance plans. Please call us to verify your coverage before your first appointment.</p>
    <div class="insurance-grid mb-8">
      <div class="insurance-card">BlueCross BlueShield</div>
      <div class="insurance-card">Aetna</div>
      <div class="insurance-card">Cigna</div>
      <div class="insurance-card">United Healthcare</div>
      <div class="insurance-card">Medicaid</div>
      <div class="insurance-card">Medicare</div>
      <div class="insurance-card">Tricare</div>
      <div class="insurance-card">+ More</div>
    </div>
    <p class="text-muted" style="font-size:.9rem;">Don&rsquo;t see your plan? Call <a href="tel:4437987707">(443) 798-7707</a> to verify coverage &mdash; we work with many additional carriers.</p>
  </div>
</section>

<!-- FAQ TEASER -->
<section class="section" id="faq">
  <div class="container">
    <div class="section-header center">
      <span class="eyebrow">FAQ</span>
      <h2>Common Questions</h2>
    </div>
    <div class="faq-list">
      <div class="faq-item">
        <button class="faq-question">What should I expect at my first appointment? <span class="faq-chevron">&#8964;</span></button>
        <div class="faq-answer"><p>Your first visit is a comprehensive psychiatric evaluation. Matthew will discuss your symptoms, medical history, current medications, and treatment goals. Together you&rsquo;ll create a personalized care plan. Appointments are available in-person in Towson or via telehealth throughout Maryland.</p></div>
      </div>
      <div class="faq-item">
        <button class="faq-question">Do you accept insurance? <span class="faq-chevron">&#8964;</span></button>
        <div class="faq-answer"><p>Yes &mdash; we accept most major insurance plans including BlueCross BlueShield, Aetna, Cigna, United Healthcare, Medicaid, Medicare, and Tricare. Please call (443) 798-7707 to verify your specific coverage before your appointment.</p></div>
      </div>
      <div class="faq-item">
        <button class="faq-question">Do you offer telehealth appointments? <span class="faq-chevron">&#8964;</span></button>
        <div class="faq-answer"><p>Yes &mdash; telehealth appointments are available for patients throughout Maryland. Secure video visits provide the same quality of care from the comfort of your home. All you need is a smartphone, tablet, or computer with a camera.</p></div>
      </div>
      <div class="faq-item">
        <button class="faq-question">Do you treat children and adolescents? <span class="faq-chevron">&#8964;</span></button>
        <div class="faq-answer"><p>Absolutely. Matthew has extensive experience with pediatric and adolescent psychiatry, including ADHD, anxiety, depression, autism spectrum disorder, and behavioral challenges. We welcome patients from early childhood through adulthood.</p></div>
      </div>
      <div class="faq-item">
        <button class="faq-question">How do I schedule an appointment? <span class="faq-chevron">&#8964;</span></button>
        <div class="faq-answer"><p>You can call us at (443) 798-7707, email mmauro@caapsych.com, or use the contact form on our website. New patients are currently being accepted. We&rsquo;ll work to get you in as quickly as possible.</p></div>
      </div>
    </div>
    <div class="text-center" style="margin-top:var(--sp-8)">
      <a href="/faq" class="btn btn-outline">View All FAQs &#8594;</a>
    </div>
  </div>
</section>

<!-- CTA SECTION -->
<section class="cta-section" id="book">
  <div class="container">
    <span class="eyebrow-white">Get Started Today</span>
    <h2>Ready to Take the First Step?</h2>
    <p>New patients are welcome. Reach out today &mdash; we&rsquo;ll work to get you scheduled as quickly as possible, with both in-person and telehealth options available.</p>
    <div class="cta-phone"><a href="tel:4437987707">(443) 798-7707</a></div>
    <p style="color:rgba(255,255,255,.7);font-size:.9rem;">1200 East Joppa Road, Suite A &bull; Towson, MD 21286 &bull; <a href="mailto:mmauro@caapsych.com" style="color:rgba(255,255,255,.75)">mmauro@caapsych.com</a></p>
    <div class="cta-actions">
      <a href="/contact" class="btn btn-white btn-lg">Schedule an Appointment</a>
      <a href="tel:4437987707" class="btn btn-outline-white btn-lg">Call Us Now</a>
    </div>
  </div>
</section>

<!-- FOOTER -->
</BaseLayout>
