---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Contact | Mind Menders Psychiatric Care | Towson, MD"
  description="Schedule an appointment with Matthew Mauro, PMHNP-BC at Mind Menders Psychiatric Care in Towson, MD. In-person and telehealth available. Call (443) 798-7707."
  activeNav="contact"
>
<section class="page-hero">
  <div class="container">
    <nav class="breadcrumb"><a href="/">Home</a> &rsaquo; <span>Contact</span></nav>
    <span class="eyebrow-white">Get in Touch</span>
    <h1>Schedule Your Appointment</h1>
    <p>New patients are currently being accepted. Reach out by phone, email, or the form below &mdash; we will get back to you within 1 business day.</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="contact-grid">
      <div>
        <div class="contact-info-card">
          <h3>Contact Information</h3>
          <div class="contact-detail">
            <div class="contact-detail-icon">&#128222;</div>
            <div class="contact-detail-text"><strong>Phone</strong><span><a href="tel:4437987707">(443) 798-7707</a></span></div>
          </div>
          <div class="contact-detail">
            <div class="contact-detail-icon">&#128251;</div>
            <div class="contact-detail-text"><strong>Fax</strong><span>(443) 798-2772</span></div>
          </div>
          <div class="contact-detail">
            <div class="contact-detail-icon">&#128140;</div>
            <div class="contact-detail-text"><strong>Email</strong><span><a href="mailto:mmauro@caapsych.com">mmauro@caapsych.com</a></span></div>
          </div>
          <div class="contact-detail">
            <div class="contact-detail-icon">&#127968;</div>
            <div class="contact-detail-text"><strong>Office</strong><span>1200 East Joppa Road, Suite A<br>Towson, MD 21286</span></div>
          </div>
          <div class="contact-detail">
            <div class="contact-detail-icon">&#128337;</div>
            <div class="contact-detail-text"><strong>Hours</strong><span>Monday &ndash; Friday: 9 AM &ndash; 5 PM<br>Telehealth with flexible scheduling</span></div>
          </div>
        </div>
        <div style="margin-top:var(--sp-6);background:var(--teal-light);border-radius:var(--radius-lg);padding:var(--sp-6);border:1px solid var(--border);text-align:center">
          <div style="font-size:2rem;margin-bottom:var(--sp-3)">&#127968;</div>
          <p style="font-weight:600;color:var(--text-dark);margin-bottom:var(--sp-2)">1200 East Joppa Road, Suite A</p>
          <p style="font-size:.875rem;color:var(--text-muted);margin-bottom:var(--sp-4)">Towson, MD 21286</p>
          <a href="https://maps.google.com/?q=1200+East+Joppa+Road+Towson+MD" target="_blank" class="btn btn-outline btn-sm">Get Directions &#8594;</a>
        </div>
      </div>
      <div class="contact-form-card">
        <span class="eyebrow">New Patient Inquiry</span>
        <h3>Request an Appointment</h3>
        <p style="font-size:.875rem;color:var(--text-muted);margin-bottom:var(--sp-6)">Fill out the form and we will contact you to confirm your appointment.</p>
        <form name="contact" method="POST" data-netlify="true" action="/thank-you.html">
          <input type="hidden" name="form-name" value="contact">
          <div class="form-row">
            <div class="form-group"><label for="fname">First Name *</label><input type="text" id="fname" name="first-name" placeholder="First name" required></div>
            <div class="form-group"><label for="lname">Last Name *</label><input type="text" id="lname" name="last-name" placeholder="Last name" required></div>
          </div>
          <div class="form-group"><label for="email">Email *</label><input type="email" id="email" name="email" placeholder="your@email.com" required></div>
          <div class="form-group"><label for="phone">Phone *</label><input type="tel" id="phone" name="phone" placeholder="(xxx) xxx-xxxx" required></div>
          <div class="form-group"><label for="ptype">Patient Type *</label>
            <select id="ptype" name="patient-type" required>
              <option value="">Select...</option>
              <option>New Patient &mdash; Adult (18+)</option>
              <option>New Patient &mdash; Adolescent (13-17)</option>
              <option>New Patient &mdash; Child (under 13)</option>
              <option>Existing Patient</option>
            </select>
          </div>
          <div class="form-group"><label for="appt">Appointment Type</label>
            <select id="appt" name="appointment-type">
              <option value="">Select...</option>
              <option>In-Person (Towson, MD)</option>
              <option>Telehealth (video)</option>
              <option>No preference</option>
            </select>
          </div>
          <div class="form-group"><label for="ins">Insurance Provider</label><input type="text" id="ins" name="insurance" placeholder="e.g. BlueCross BlueShield"></div>
          <div class="form-group"><label for="reason">Reason for Visit</label><textarea id="reason" name="reason" placeholder="Brief description (optional)..."></textarea></div>
          <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center;padding:1rem;font-size:1rem">Submit Request &#8594;</button>
          <p style="font-size:.75rem;color:var(--text-muted);margin-top:var(--sp-3);text-align:center">Your information is protected under HIPAA.</p>
        </form>
      </div>
    </div>
  </div>
</section>

<section class="section section-light">
  <div class="container" style="max-width:860px">
    <div class="section-header center"><span class="eyebrow">What to Expect</span><h2>Your First Appointment</h2></div>
    <div class="steps-grid">
      <div class="step-card"><div class="step-num">1</div><h3>Reach Out</h3><p>Call, email, or submit the form. We will confirm availability and verify your insurance.</p></div>
      <div class="step-card"><div class="step-num">2</div><h3>Complete Intake</h3><p>We will send paperwork to complete before your appointment so we can make the most of your visit.</p></div>
      <div class="step-card"><div class="step-num">3</div><h3>Your Evaluation</h3><p>Matthew conducts a thorough psychiatric evaluation, listening to your history, symptoms, and goals.</p></div>
      <div class="step-card"><div class="step-num">4</div><h3>Your Care Plan</h3><p>Together you will build a personalized treatment plan and start the path toward feeling better.</p></div>
    </div>
  </div>
</section>
</BaseLayout>
